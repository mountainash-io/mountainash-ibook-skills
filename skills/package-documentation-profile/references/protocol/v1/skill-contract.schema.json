{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mountainash:textbook-skills:skill-contract:1",
  "title": "SkillContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "version", "capabilities", "modes", "behaviors", "inputs", "artifact_schema_imports", "allowed_outputs", "result_schema", "validators", "warning_codes", "preservation", "failure", "digest_paths"],
  "properties": {
    "$schema": {"const": "urn:mountainash:textbook-skills:skill-contract:1"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["interactive", "orchestrated"]}},
    "behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["incremental", "full"]}},
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schema", "required", "read_only"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "read_only": {"type": "boolean"}
        }
      }
    },
    "artifact_schema_imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^urn:[^\\s]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
        }
      }
    },
    "allowed_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "result_schema": {"const": "urn:mountainash:textbook-skills:completion-result:1"},
    "validators": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "warning_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "unit"],
      "properties": {
        "policy": {"const": "preserve_untargeted"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_outputs", "result_status"],
      "properties": {
        "canonical_outputs": {"const": "inspectable"},
        "result_status": {"const": "failed"}
      }
    },
    "digest_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
